# ==============================================================================
# KisanSahay Environment Configuration Template
# Copy this file to .env and populate with your local values or secrets.
# Do NOT commit actual API keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node.js Express Proxy Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FLASK_BACKEND_URL=http://127.0.0.1:8000
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Python Backend & RAG Server Configuration (app.py)
# ------------------------------------------------------------------------------
FASTAPI_PORT=8000
HOST=0.0.0.0

# Administrative API Key for data sync, health alerts & review operations
ADMIN_API_KEY=your-admin-secret-key-here

# ------------------------------------------------------------------------------
# 3. AI & LLM Model Keys (Gemini & Ollama)
# ------------------------------------------------------------------------------
# Primary Google Gemini AI API Key for RAG Answer Synthesis & Grounding
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Local Ollama URL (used for local embeddings & fallback LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 4. ChromaDB Vector Database Configuration
# ------------------------------------------------------------------------------
CHROMA_DIR=./chroma_db
CHROMA_DB_DIR=./chroma_db
COLLECTION_NAME=kisansahay_knowledge
CHROMA_COLLECTION=kisansahay_knowledge
DISTANCE_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 5. Search & External Lookups
# ------------------------------------------------------------------------------
# Enable or disable isolated DuckDuckGo web search fallback (1 = enabled, 0 = disabled)
KVK_WEB_SEARCH=1

# ------------------------------------------------------------------------------
# 6. Optional Indian Language Translation & Neural TTS Services
# ------------------------------------------------------------------------------
# Provider: 'offline' (built-in 25 Indian languages), 'google', or 'bhashini'
TRANSLATION_PROVIDER=offline
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Government of India Bhashini Translation API (Optional)
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Google Cloud Text-to-Speech API Key (Optional)
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# ------------------------------------------------------------------------------
# 7. Automated Stale Record & Health Alerting (SMTP Email - Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=alerts@kisansahay.in
ALERT_EMAIL_TO=admin@kisansahay.in
STALE_ALERT_THRESHOLD=5
