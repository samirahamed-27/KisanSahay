# KisanSahay Mobile App Environment Configuration

# Backend API URL (Default to local dev server or production deployment)
API_BASE_URL=http://localhost:3000/api

# Google Gemini AI Key (Used for Sahay AI Assistant)
GEMINI_API_KEY=

# Google Maps / Location Geocoding API Key
GOOGLE_MAPS_API_KEY=

# Fast2SMS API Key (For Indian OTP delivery)
FAST2SMS_API_KEY=

# Twilio Credentials (Optional International SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Document Vault Encryption Salt
VAULT_ENCRYPTION_SALT=kisansahay_secure_vault_salt_2026
